# ---------------------------------------------------------------------------
# JobHunter configuration.  Copy to .env.local and fill in.
#   cp .env.example .env.local
# .env.local is gitignored and never leaves this machine.
# ---------------------------------------------------------------------------

# --- Claude backend -------------------------------------------------------
# How Claude is called. One of: mock | api | cli
#   mock - canned fixtures. No network, no cost. Leave this while developing.
#   api  - the Anthropic API, metered per token. Needs ANTHROPIC_API_KEY below.
#          Reliable structured output. Recommended for real use.
#   cli  - shell out to the locally installed `claude` CLI, so calls are billed
#          to your Claude Pro/Max subscription instead of API credits. No
#          structured-output guarantee (JSON is parsed out of text and
#          validated), slower, and subject to your subscription's usage limits.
#          Workable for tailoring; poor for bulk job scoring.
# Leaving this blank means: api if ANTHROPIC_API_KEY is set, otherwise mock.
CLAUDE_PROVIDER=mock

# Only for CLAUDE_PROVIDER=cli, if `claude` is not on PATH for the server.
CLAUDE_CLI_PATH=claude

# --- Claude API (required only when CLAUDE_PROVIDER=api) -------------------
# A Claude.ai subscription does NOT work here: the API bills separately from
# a credit balance at https://platform.claude.com. Separate product, own key.
# Used for resume parsing, job scoring and resume tailoring.
ANTHROPIC_API_KEY=sk-ant-...

# Hard ceiling on Claude spend per calendar month, in USD.
# Paid calls are REFUSED once the month's spend passes this. Not a budget,
# a brake. Raise it deliberately.
CLAUDE_MONTHLY_USD_CAP=5.00

# Models. Haiku scores jobs in bulk; Opus does the careful resume rewriting.
CLAUDE_SCORING_MODEL=claude-haiku-5-5
CLAUDE_TAILOR_MODEL=claude-opus-5-5

# --- Job source ------------------------------------------------------------
# One of: mock | jsearch-rapidapi | jsearch-direct
#   mock             - canned fixtures, costs nothing, no network. Use for dev.
#   jsearch-rapidapi - JSearch via RapidAPI marketplace (free BASIC tier available)
#   jsearch-direct   - the same API bought direct from OpenWeb Ninja (pay-as-you-go)
JOB_SOURCE=mock

# For JOB_SOURCE=jsearch-rapidapi  (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# For JOB_SOURCE=jsearch-direct  (https://www.openwebninja.com/api)
OPENWEBNINJA_API_KEY=
# Copy the search endpoint's base URL from your OpenWeb Ninja dashboard.
# Not hardcoded because their public agent storefront does not document a
# plain REST host. Example shape only:  https://api.example/jsearch
JSEARCH_DIRECT_BASE_URL=

# Your plan's monthly request allowance, so the UI can show "N / QUOTA used".
# RapidAPI BASIC = 200, PRO = 10000, ULTRA = 50000, MEGA = 200000.
JSEARCH_MONTHLY_QUOTA=200
# Per-request cost once you exceed the included quota (RapidAPI PRO overage).
JSEARCH_OVERAGE_USD=0.003

# --- Search behaviour ------------------------------------------------------
# Postings older than this are discarded. Your requirement: under two weeks.
MAX_JOB_AGE_DAYS=14
# How many prefiltered jobs get sent to Claude for real scoring per search.
SCORE_TOP_N=25
