# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but .env.example is the template the README tells you to copy, so it has
# to be in the repo. Real env files stay ignored by the line above.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# JobHunter local data: resumes, SQLite db, generated documents.
/data
.env.local
